# 本地临时
/tmp/
*.log
*.tmp

# Go 构建产物
/bin/
/dist/
/probe/bin/
/probe/tmp/

# 第三方参考源码：不 vendor，用 scripts/fetch-refs.sh 拉取到 refs/
/refs/dsc/

# 编辑器
.vscode/
.idea/
dist/

# 本地临时（A/B 输出、探针二进制）
.tmp-*\.json
# 仓根直接 go build 的产物：文件名就是产品名，带空格（.gitignore 里空格不用转义）。
# 前缀 / 表示只在仓根匹配，不吞掉 dist/ 或 tmp/ 里的同名文件（那两个目录已整体忽略）。
/DSH GO.exe
/DSH TUI GO.exe
__pycache__/

# 构建产物：不入库（发版走 Release 附件）
*.exe
