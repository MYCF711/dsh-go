  {
    "name": "pwsh",
    "description": "执行 PowerShell 命令（优先 pwsh，退回 powershell）。查系统、跑脚本时用。",
    "parameters": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "description": "这段命令干什么，5-10 个字，给用户看的（例如「列出当前目录」「查看进程列表」）"
        },
        "command": {
          "type": "string",
          "description": "要执行的 PowerShell 命令（一条或多条，用分号分隔）"
        },
        "timeoutMs": {
          "type": "number",
          "description": "超时毫秒数；省略用默认 120000，上限 600000"
        },
        "workdir": {
          "type": "string",
          "description": "可选：工作目录（相对当前工作目录），默认当前目录"
        },
        "run_in_background": {
          "type": "boolean",
          "description": "立刻转后台并返回 job_id，不等命令结束（长任务用这个）：用 job_output 取输出、job_kill 终止"
        },
