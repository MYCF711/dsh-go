[
  {
    "name": "bash",
    "description": "在持久 bash 会话里执行命令，cwd 跨命令保留；无输出超时就转后台。",
    "parameters": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "description": "要执行的 bash 命令；cwd 跨命令保留"
        },
        "description": {
          "type": "string",
          "description": "这段命令干什么，5-10 个字，给用户看的（例如「列出当前目录」）"
        },
        "idle_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900,
          "description": "多久无输出转后台，默认 600"
        }
      },
      "required": [
        "command",
        "description"
      ],
      "additionalProperties": false
    },
    "caps": {
      "writes": true,
      "executes": true
    }
  },
  {
    "name": "edit",
    "description": "把文件中的 old_string 逐字替换为 new_string；要求唯一匹配，多处须显式 replace_all。",
    "parameters": {
      "type": "object",
      "properties": {
        "file_path": {
          "type": "string",
          "description": "文件路径（正斜杠，相对工作区根）"
        },
        "old_string": {
          "type": "string",
          "description": "要被替换的原文，必须逐字匹配（含缩进）"
        },
        "new_string": {
          "type": "string",
          "description": "替换后的内容"
        },
        "replace_all": {
          "type": "boolean",
          "description": "默认 false：old_string 在文件里必须唯一"
        }
      },
      "required": [
        "file_path",
        "old_string",
        "new_string"
      ],
      "additionalProperties": false
    },
    "caps": {
      "writes": true
    }
  },
  {
    "name": "glob",
    "description": "按 glob 模式找文件（支持 **），只返回路径；自动跳过 .git/refs/node_modules。",
    "parameters": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "glob 模式（相对 path），支持 ** 跨目录，如 **/*.go"
        },
        "path": {
          "type": "string",
          "description": "起始目录，默认工作区根"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "最多返回多少条，默认 200"
        }
      },
      "required": [
        "pattern"
      ],
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "grep",
    "description": "按 Go 正则搜内容，返回 文件:行:文本；自动跳过 .git/refs/node_modules，比 bash grep -r 准。",
    "parameters": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "Go 正则语法"
        },
        "path": {
          "type": "string",
          "description": "起始目录，默认工作区根"
        },
        "include": {
          "type": "string",
          "description": "只搜匹配该 glob 的文件，如 **/*.go"
        },
        "ignore_case": {
          "type": "boolean",
          "description": "默认 false"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "最多返回多少条匹配，默认 100"
        }
      },
      "required": [
        "pattern"
      ],
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "history_search",
    "description": "在原始日志里按关键词回查（含已被压缩遮蔽的内容）；想找回「之前那段细节」时用。",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "要回查的关键词（字面匹配，大小写敏感）"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "最多返回多少条，默认 10"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "job_kill",
    "description": "终止一个后台任务。",
    "parameters": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务 id"
        },
        "reason": {
          "type": "string",
          "description": "可选：记录在日志里并转发给任务"
        }
      },
      "required": [
        "job_id"
      ],
      "additionalProperties": false
    },
    "caps": {
      "destructive": true
    }
  },
  {
    "name": "job_list",
    "description": "列出后台任务及其状态。",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "job_output",
    "description": "取后台任务输出（可短等）。任务没结束也能反复取。",
    "parameters": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务 id，如 job-1"
        },
        "wait": {
          "type": "boolean",
          "description": "是否阻塞等待任务结束，默认 false"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120000,
          "description": "wait=true 时最多等多少毫秒，默认 30000"
        }
      },
      "required": [
        "job_id"
      ],
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "read",
    "description": "读文件（按行窗口）。改文件前必须先读；大文件用 offset/limit 分段。",
    "parameters": {
      "type": "object",
      "properties": {
        "file_path": {
          "type": "string",
          "description": "文件路径（正斜杠，相对工作区根）"
        },
        "offset": {
          "type": "integer",
          "minimum": 1,
          "description": "起始行号（1 基），默认 1"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "最多返回多少行，默认 2000"
        }
      },
      "required": [
        "file_path"
      ],
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "write",
    "description": "新建或整体覆盖文件。覆盖已有文件前必须先 read。",
    "parameters": {
      "type": "object",
      "properties": {
        "file_path": {
          "type": "string",
          "description": "文件路径（正斜杠，相对工作区根）"
        },
        "content": {
          "type": "string",
          "description": "完整文件内容"
        }
      },
      "required": [
        "file_path",
        "content"
      ],
      "additionalProperties": false
    },
    "caps": {
      "writes": true
    }
  }
]
