[
  {
    "name": "ask_user_question",
    "description": "向人提问（可一次问多个）并等回答，本轮到此结束。需要人拍板时用，别自己猜。",
    "parameters": {
      "type": "object",
      "properties": {
        "questions": {
          "type": "array",
          "description": "要先问人的问题；一次问全，别挤成多轮",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "这个问题的稳定 id；回答里会回显"
              },
              "question": {
                "type": "string",
                "description": "具体要问的那句话"
              },
              "header": {
                "type": "string",
                "description": "可选的短标题，例如「确认」「选模式」"
              },
              "options": {
                "type": "array",
                "description": "可选候选；推荐项放第一个并在标签后加「（推荐）」",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "description": "给人看的一句话选项"
                    },
                    "description": {
                      "type": "string",
                      "description": "这个选择的取舍，可选"
                    }
                  },
                  "required": [
                    "label"
                  ],
                  "additionalProperties": true
                }
              },
              "multi_select": {
                "type": "boolean",
                "description": "能不能多选，默认不能"
              }
            },
            "required": [
              "id",
              "question"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "questions"
      ],
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "bash",
    "description": "在持久 bash 会话里执行命令，cwd 跨命令保留；无输出超时就转后台。",
    "parameters": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "description": "要执行的 bash 命令；cwd 跨命令保留"
        },
        "description": {
          "type": "string",
          "description": "这段命令干什么，5-10 个字，给用户看的（例如「列出当前目录」）"
        },
        "idle_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900,
          "description": "多久无输出转后台，默认 600"
        },
        "run_in_background": {
          "type": "boolean",
          "description": "立刻转后台并返回 job_id，不等命令结束（长任务用这个，别去调小 idle_seconds）"
        },
        "sandbox_permissions": {
          "type": "string",
          "enum": [
            "workspace-write",
            "danger-full-access"
          ],
          "description": "可选：仅本次调用的 sandbox 请求。danger-full-access 需要先经审批；不会改变会话档位"
        }
      },
      "required": [
        "command",
        "description"
      ],
      "additionalProperties": false
    },
    "caps": {
      "writes": true,
      "executes": true
    }
  },
  {
    "name": "create_goal",
    "description": "为需要多轮才能完成的事建一个跨会话存活的目标。",
    "parameters": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "string",
          "description": "这个长程目标要达成什么，一句话说清"
        },
        "max_goal_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "description": "允许的总轮次上限，可省略，默认 256"
        }
      },
      "required": [
        "objective"
      ],
      "additionalProperties": false
    },
    "caps": {
      "writes": true
    }
  },
  {
    "name": "edit",
    "description": "把文件中的 old_string 逐字替换为 new_string；要求唯一匹配，多处须显式 replace_all。",
    "parameters": {
      "type": "object",
      "properties": {
        "file_path": {
          "type": "string",
          "description": "文件路径（正斜杠，相对工作区根）"
        },
        "old_string": {
          "type": "string",
          "description": "要被替换的原文，必须逐字匹配（含缩进）"
        },
        "new_string": {
          "type": "string",
          "description": "替换后的内容"
        },
        "replace_all": {
          "type": "boolean",
          "description": "默认 false：old_string 在文件里必须唯一"
        }
      },
      "required": [
        "file_path",
        "old_string",
        "new_string"
      ],
      "additionalProperties": false
    },
    "caps": {
      "writes": true
    }
  },
  {
    "name": "enter_plan_mode",
    "description": "进入计划模式：此后只能读和想，不能改盘、不能跑命令。把方案想清楚再用 exit_plan_mode 提交给人批。",
    "parameters": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "description": "一句话说明要规划什么（可选）"
        }
      },
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "exec_literal",
    "description": "直接运行 .exe，参数逐个原样传入、不被 Git-Bash 转换。适合 ipconfig /all。",
    "parameters": {
      "type": "object",
      "properties": {
        "program": {
          "type": "string",
          "description": ".exe 的绝对路径，例如 C:/Windows/System32/ipconfig.exe"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "可选：逐个原样传给程序的参数，不拆分、不转义"
        },
        "timeout_seconds": {
          "type": "integer",
          "description": "可选：超时秒数，默认 60，上限 600"
        }
      },
      "required": [
        "program"
      ],
      "additionalProperties": false
    },
    "caps": {
      "writes": true,
      "executes": true
    }
  },
  {
    "name": "exit_plan_mode",
    "description": "提交方案并退出计划模式。把 markdown 方案正文放进 plan；提交后本轮结束、控制权交回人。",
    "parameters": {
      "type": "object",
      "properties": {
        "plan": {
          "type": "string",
          "description": "方案正文（markdown）"
        }
      },
      "required": [
        "plan"
      ],
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "get_goal",
    "description": "查当前会话的目标和 revision；改目标前先调它。",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "github",
    "description": "调 GitHub REST API（path 如 repos/o/r/issues）。写方法要 confirm 与令牌。",
    "parameters": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "GitHub API 路径，不带前导斜杠，如 repos/o/r/issues"
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PATCH",
            "PUT",
            "DELETE"
          ],
          "description": "HTTP 方法，默认 GET；写方法必须带 confirm"
        },
        "body": {
          "type": "string",
          "description": "写操作的 JSON 请求体（字符串形式）"
        },
        "confirm": {
          "type": "boolean",
          "description": "写操作必须为 true，否则直接拒绝"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "caps": {
      "writes": true,
      "network": true
    }
  },
  {
    "name": "glob",
    "description": "按 glob 模式找文件（支持 **），只返回路径；自动跳过 .git/refs/node_modules。",
    "parameters": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "glob 模式（相对 path），支持 ** 跨目录，如 **/*.go"
        },
        "path": {
          "type": "string",
          "description": "起始目录，默认工作区根"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "最多返回多少条，默认 200"
        }
      },
      "required": [
        "pattern"
      ],
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "grep",
    "description": "按 Go 正则搜内容，返回 文件:行:文本；自动跳过 .git/refs/node_modules，比 bash grep -r 准。",
    "parameters": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "Go 正则语法"
        },
        "path": {
          "type": "string",
          "description": "起始目录，默认工作区根"
        },
        "include": {
          "type": "string",
          "description": "只搜匹配该 glob 的文件，如 **/*.go"
        },
        "ignore_case": {
          "type": "boolean",
          "description": "默认 false"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "最多返回多少条匹配，默认 100"
        }
      },
      "required": [
        "pattern"
      ],
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "hindsight_capture_initiative",
    "description": "把一个倡议记成一页记忆（标题 + 两三句在做什么、为什么）；先记下来，以后再搜。",
    "parameters": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "倡议名词，短"
        },
        "summary": {
          "type": "string",
          "description": "两三句：在做什么、为什么"
        }
      },
      "required": [
        "title",
        "summary"
      ],
      "additionalProperties": false
    },
    "caps": {
      "writes": true
    }
  },
  {
    "name": "hindsight_ingest_document",
    "description": "把一段结论/踩坑/约定存进本机记忆，下次能按 id 捞回来；趁还记得时用。",
    "parameters": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "这段记忆叫什么，会参与生成 id"
        },
        "content": {
          "type": "string",
          "description": "要记住的正文"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "可选标签"
        }
      },
      "required": [
        "title",
        "content"
      ],
      "additionalProperties": false
    },
    "caps": {
      "writes": true
    }
  },
  {
    "name": "hindsight_list_knowledge_pages",
    "description": "列出本机存过的记忆（id、标题、字数，新→旧）；不确定有哪些记忆时先用它。",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "hindsight_read_knowledge_page",
    "description": "按 id 读一份记忆的正文全文；已知 id、要看完整内容时用它。",
    "parameters": {
      "type": "object",
      "properties": {
        "page_id": {
          "type": "string",
          "description": "文档 id，先用 list/search 拿到（DSH 的叫法）"
        },
        "id": {
          "type": "string",
          "description": "同上，另一种叫法；两个都给时以 page_id 为准"
        }
      },
      "required": [
        "page_id"
      ],
      "additionalProperties": false
    },
    "caps": {}
