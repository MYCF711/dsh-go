[
  {
    "name": "ask_user_question",
    "description": "向人提问（可一次问多个）并等回答，本轮到此结束。需要人拍板时用，别自己猜。",
    "parameters": {
      "type": "object",
      "properties": {
        "questions": {
          "type": "array",
          "description": "要先问人的问题；一次问全，别挤成多轮",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "这个问题的稳定 id；回答里会回显"
              },
              "question": {
                "type": "string",
                "description": "具体要问的那句话"
              },
              "header": {
                "type": "string",
                "description": "可选的短标题，例如「确认」「选模式」"
              },
              "options": {
                "type": "array",
                "description": "可选候选；推荐项放第一个并在标签后加「（推荐）」",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "description": "给人看的一句话选项"
                    },
                    "description": {
                      "type": "string",
                      "description": "这个选择的取舍，可选"
                    }
                  },
                  "required": [
                    "label"
                  ],
                  "additionalProperties": true
                }
              },
              "multi_select": {
                "type": "boolean",
                "description": "能不能多选，默认不能"
              }
            },
            "required": [
              "id",
              "question"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "questions"
      ],
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "bash",
    "description": "在持久 bash 会话里执行命令，cwd 跨命令保留；无输出超时就转后台。",
    "parameters": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "description": "要执行的 bash 命令；cwd 跨命令保留"
        },
        "description": {
          "type": "string",
          "description": "这段命令干什么，5-10 个字，给用户看的（例如「列出当前目录」）"
        },
        "idle_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900,
          "description": "多久无输出转后台，默认 600"
        }
      },
      "required": [
        "command",
        "description"
      ],
      "additionalProperties": false
    },
    "caps": {
      "writes": true,
      "executes": true
    }
  },
  {
    "name": "edit",
    "description": "把文件中的 old_string 逐字替换为 new_string；要求唯一匹配，多处须显式 replace_all。",
    "parameters": {
      "type": "object",
      "properties": {
        "file_path": {
          "type": "string",
          "description": "文件路径（正斜杠，相对工作区根）"
        },
        "old_string": {
          "type": "string",
          "description": "要被替换的原文，必须逐字匹配（含缩进）"
        },
        "new_string": {
          "type": "string",
          "description": "替换后的内容"
        },
        "replace_all": {
          "type": "boolean",
          "description": "默认 false：old_string 在文件里必须唯一"
        }
      },
      "required": [
        "file_path",
        "old_string",
        "new_string"
      ],
      "additionalProperties": false
    },
    "caps": {
      "writes": true
    }
  },
  {
    "name": "exec_literal",
    "description": "直接运行 .exe，参数逐个原样传入、不被 Git-Bash 转换。适合 ipconfig /all。",
    "parameters": {
      "type": "object",
      "properties": {
        "program": {
          "type": "string",
          "description": ".exe 的绝对路径，例如 C:/Windows/System32/ipconfig.exe"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "可选：逐个原样传给程序的参数，不拆分、不转义"
        },
        "timeout_seconds": {
          "type": "integer",
          "description": "可选：超时秒数，默认 60，上限 600"
        }
      },
      "required": [
        "program"
      ],
      "additionalProperties": false
    },
    "caps": {
      "writes": true,
      "executes": true
    }
  },
  {
    "name": "github",
    "description": "调 GitHub REST API（path 如 repos/o/r/issues）。写方法要 confirm 与令牌。",
    "parameters": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "GitHub API 路径，不带前导斜杠，如 repos/o/r/issues"
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PATCH",
            "PUT",
            "DELETE"
          ],
          "description": "HTTP 方法，默认 GET；写方法必须带 confirm"
        },
        "body": {
          "type": "string",
          "description": "写操作的 JSON 请求体（字符串形式）"
        },
        "confirm": {
          "type": "boolean",
          "description": "写操作必须为 true，否则直接拒绝"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "caps": {
      "writes": true,
      "network": true
    }
  },
  {
    "name": "glob",
    "description": "按 glob 模式找文件（支持 **），只返回路径；自动跳过 .git/refs/node_modules。",
    "parameters": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "glob 模式（相对 path），支持 ** 跨目录，如 **/*.go"
        },
        "path": {
          "type": "string",
          "description": "起始目录，默认工作区根"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "最多返回多少条，默认 200"
        }
      },
      "required": [
        "pattern"
      ],
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "grep",
    "description": "按 Go 正则搜内容，返回 文件:行:文本；自动跳过 .git/refs/node_modules，比 bash grep -r 准。",
    "parameters": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "Go 正则语法"
        },
        "path": {
          "type": "string",
          "description": "起始目录，默认工作区根"
        },
        "include": {
          "type": "string",
          "description": "只搜匹配该 glob 的文件，如 **/*.go"
        },
        "ignore_case": {
          "type": "boolean",
          "description": "默认 false"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "最多返回多少条匹配，默认 100"
        }
      },
      "required": [
        "pattern"
      ],
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "history_search",
    "description": "在原始日志里按关键词回查（含已被压缩遮蔽的内容）；想找回「之前那段细节」时用。",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "要回查的关键词（字面匹配，大小写敏感）"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "最多返回多少条，默认 10"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "job_kill",
    "description": "终止一个后台任务。",
    "parameters": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务 id"
        },
        "reason": {
          "type": "string",
          "description": "可选：记录在日志里并转发给任务"
        }
      },
      "required": [
        "job_id"
      ],
      "additionalProperties": false
    },
    "caps": {
      "destructive": true
    }
  },
  {
    "name": "job_list",
    "description": "列出后台任务及其状态。",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "job_output",
    "description": "取后台任务输出（可短等）。任务没结束也能反复取。",
    "parameters": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务 id，如 job-1"
        },
        "wait": {
          "type": "boolean",
          "description": "是否阻塞等待任务结束，默认 false"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120000,
          "description": "wait=true 时最多等多少毫秒，默认 30000"
        }
      },
      "required": [
        "job_id"
      ],
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "now_line",
    "description": "当前时间、日期、时区名与星期，一次拿全；别为这个跑 bash date。",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "present",
    "description": "把已存在的文件声明为交付物（不复制内容）。人需要单独打开某个文件时用。",
    "parameters": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "description": "通常 1-2 个最重要的交付物；一次最多 4 个",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "已存在文件的路径（相对当前工作目录）"
              },
              "description": {
                "type": "string",
                "description": "给人看的一句话说明"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "files"
      ],
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "pwsh",
    "description": "执行 PowerShell 命令（优先 pwsh，退回 powershell）。查系统、跑脚本时用。",
    "parameters": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "description": "要执行的 PowerShell 命令（一条或多条，用分号分隔）"
        },
        "workdir": {
          "type": "string",
          "description": "可选：工作目录（相对当前工作目录），默认当前目录"
        },
        "timeout_seconds": {
          "type": "integer",
          "description": "可选：超时秒数，默认 120，上限 600"
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    },
    "caps": {
      "writes": true,
      "executes": true
    }
  },
  {
    "name": "read",
    "description": "读文件（按行窗口）。改文件前必须先读；大文件用 offset/limit 分段。",
    "parameters": {
      "type": "object",
      "properties": {
        "file_path": {
          "type": "string",
          "description": "文件路径（正斜杠，相对工作区根）"
        },
        "offset": {
          "type": "integer",
          "minimum": 1,
          "description": "起始行号（1 基），默认 1"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "最多返回多少行，默认 2000"
        }
      },
      "required": [
        "file_path"
      ],
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "read_image",
    "description": "读取一张图片交给模型看（PNG/JPEG/WebP/GIF）。要看图时用，不要自己造缩略图。",
    "parameters": {
      "type": "object",
      "properties": {
        "file_path": {
          "type": "string",
          "description": "图片文件路径（相对当前工作目录）"
        }
      },
      "required": [
        "file_path"
      ],
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "repo_here",
    "description": "报告当前目录属于哪个 GitHub 仓库（owner/name 与分支）。",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "subagent",
    "description": "把一件独立的事交给子代理跑（它有自己的上下文），只拿结果回来。",
    "parameters": {
      "type": "object",
      "properties": {
        "cwd": {
          "type": "string",
          "description": "子代理的初始工作目录；相对路径按当前目录算，省略表示继承"
        },
        "description": {
          "type": "string",
          "description": "3-5 个词的短描述，给人看"
        },
        "prompt": {
          "type": "string",
          "description": "完整、自包含的任务；子代理看不到本会话的历史"
        }
      },
      "required": [
        "description",
        "prompt"
      ],
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "team_task_create",
    "description": "建一条团队任务并返回 id；分工前先建任务。",
    "parameters": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "string",
          "description": "一句话目标，祈使句"
        },
        "description": {
          "type": "string",
          "description": "细节与验收标准"
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "依赖的任务 id；它们没完成前不该开工"
        }
      },
      "required": [
        "subject",
        "description"
      ],
      "additionalProperties": false
    },
    "caps": {
      "writes": true
    }
  },
  {
    "name": "team_task_get",
    "description": "按 id 取一条任务：内容、认领人、未完成依赖。",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "任务 id，形如 task-0001-3f9a"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "team_task_list",
    "description": "列出任务，可按 status 过滤；开工前先看板子。",
    "parameters": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "in_progress",
            "completed"
          ],
          "description": "只看这个状态；省略表示全部"
        }
      },
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "team_task_update",
    "description": "改任务：claim 认领、complete 完成、delete 删除等七个动作。",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "任务 id，形如 task-0001-3f9a"
        },
        "action": {
          "type": "string",
          "enum": [
            "claim",
            "release",
            "complete",
            "reopen",
            "edit",
            "set_dependencies",
            "delete"
          ],
          "description": "claim=认领并置 in_progress；release=退回 pending 并清 owner；complete=完成；reopen=重开；edit=改 subject/description；set_dependencies=整份替换 blocked_by；delete=删除"
        },
        "owner": {
          "type": "string",
          "description": "claim 必填：你的名字或角色"
        },
        "subject": {
          "type": "string",
          "description": "action=edit 时传，才改"
        },
        "description": {
          "type": "string",
          "description": "action=edit 时传，才改（传空串表示清空）"
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "action=set_dependencies 时必填：整份替换（空数组=清空依赖）"
        }
      },
      "required": [
        "id",
        "action"
      ],
      "additionalProperties": false
    },
    "caps": {
      "writes": true
    }
  },
  {
    "name": "todo_write",
    "description": "记录或更新任务清单（整份替换）。多步骤工作时用它把计划摆出来、让人看得见进度。",
    "parameters": {
      "type": "object",
      "properties": {
        "todos": {
          "type": "array",
          "description": "完整的任务清单，替换掉之前的清单",
          "items": {
            "type": "object",
            "properties": {
              "content": {
                "type": "string",
                "description": "任务是什么——一句祈使句"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "in_progress",
                  "completed"
                ],
                "description": "pending（没开始）| in_progress（正在做）| completed（做完了）"
              }
            },
            "required": [
              "content",
              "status"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "todos"
      ],
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "web_fetch",
    "description": "取一个 HTTP(S) 网页的正文并解码成文本。要看具体某个链接的内容时用。",
    "parameters": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "要取的 HTTP(S) URL"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "caps": {
      "network": true
    }
  },
  {
    "name": "web_search",
    "description": "联网搜索，返回摘要答案与来源链接。要知道「网上现在怎么说」时用。",
    "parameters": {
      "type": "object",
      "properties": {
        "queries": {
          "type": "array",
          "description": "1–4 条查询；结果会合并去重",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "queries"
      ],
      "additionalProperties": false
    },
    "caps": {
      "network": true
    }
  },
  {
    "name": "working_directory",
    "description": "查看或切换当前工作目录（影响 read/write/glob/grep 与新开的 bash）",
    "parameters": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "要切换到的目录（相对当前目录或绝对路径）；省略则只报告当前目录"
        }
      },
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "write",
    "description": "新建或整体覆盖文件。覆盖已有文件前必须先 read。",
    "parameters": {
      "type": "object",
      "properties": {
        "file_path": {
          "type": "string",
          "description": "文件路径（正斜杠，相对工作区根）"
        },
        "content": {
          "type": "string",
          "description": "完整文件内容"
        }
      },
      "required": [
        "file_path",
        "content"
      ],
      "additionalProperties": false
    },
    "caps": {
      "writes": true
    }
  }
]
