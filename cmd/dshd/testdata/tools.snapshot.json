  {
    "name": "hindsight_search_knowledge_pages",
    "description": "按关键词搜本机记忆（标题×3 tags×2 正文×1 计分，降序）；记得大概内容但忘了 id 时用它。",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "要搜什么；空格分隔多个词，标题×3 tags×2 正文×1 计分"
        },
        "limit": {
          "type": "integer",
          "description": "最多返回几条；缺省 5，上限 20"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "caps": {}
  },
  {
    "name": "history_search",
